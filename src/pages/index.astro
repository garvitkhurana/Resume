---
import BaseLayout from '../layouts/BaseLayout.astro';

const hero = `${import.meta.env.BASE_URL}hero.jpg`;
---
<BaseLayout>
  <header class="hero">
    <div class="hero-media">
      <img src={hero} alt="" width="1920" height="1080" fetchpriority="high" />
    </div>
    <div class="hero-shade" aria-hidden="true"></div>

    <div class="hero-top">
      <span class="live"><i></i> Building with LLMs</span>
      <span>NYC · Remote</span>
    </div>

    <div class="hero-body">
      <h1 class="brand">Garvit Khurana</h1>
      <p class="role">AI engineer / AI product</p>
      <p class="lede">
        Shipping the systems that turn models into products — currently on BlackRock’s AI Accelerator.
      </p>
      <nav class="ctas" aria-label="Primary">
        <a href="https://www.linkedin.com/in/garvitkhurana/" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://github.com/garvitkhurana" target="_blank" rel="noopener">GitHub</a>
        <a href="mailto:garvit.khurana@columbia.edu">Email</a>
      </nav>
    </div>
  </header>

  <main>
    <section id="about">
      <div class="wrap">
        <p class="kicker">Now</p>
        <h2 class="section-title">In the model layer of markets.</h2>
        <p class="about-copy">
          <strong>Product Lead / Engineer II</strong> on BlackRock’s AI Accelerator.
          I own roadmap and delivery for RAG systems that create and process securities —
          from public bonds into private credit — and stay close enough to the models,
          data, and pipelines to ship without hand-waving.
        </p>
        <div class="stack" aria-label="Focus areas">
          <span>LLMs</span>
          <span>RAG</span>
          <span>Product</span>
          <span>Capital markets</span>
          <span>Private credit</span>
          <span>Python</span>
          <span>Azure</span>
        </div>
      </div>
    </section>

    <section id="impact">
      <div class="wrap">
        <p class="kicker">Signal</p>
        <div class="metrics">
          <div class="metric">
            <strong>40%</strong>
            <span>faster bond time-to-market from a RAG security-creation system</span>
          </div>
          <div class="metric">
            <strong>80%</strong>
            <span>less manual work after shipping Private Governance Platform</span>
          </div>
          <div class="metric">
            <strong>20%</strong>
            <span>lift in reporting accuracy across private markets data</span>
          </div>
        </div>
      </div>
    </section>

    <section id="experience">
      <div class="wrap">
        <p class="kicker">Work</p>
        <h2 class="section-title">Where it’s shipped.</h2>
        <div class="jobs">
          <article class="job">
            <p class="job-dates">2024 — Now</p>
            <div>
              <h3>Product Lead / Engineer II, AI Accelerator · <span class="co">BlackRock</span></h3>
              <ul>
                <li>Own strategy and roadmap for a RAG security-creation tool used internally and by clients.</li>
                <li>Scaled the system from corporate bonds into complex private credit workflows.</li>
                <li>Partner with data scientists on SQL, telemetry, and Azure pipelines that drive the roadmap.</li>
              </ul>
            </div>
          </article>
          <article class="job">
            <p class="job-dates">2022 — 2024</p>
            <div>
              <h3>Private Markets Associate · <span class="co">BlackRock</span></h3>
              <ul>
                <li>Launched Private Governance Platform across PE, funds, infrastructure, and private credit.</li>
                <li>Centralized data quality into Aladdin dashboards; +20% accuracy, −80% manual work.</li>
                <li>Built NLP issuer-search tooling for portfolio teams.</li>
              </ul>
            </div>
          </article>
          <article class="job">
            <p class="job-dates">Earlier</p>
            <div>
              <h3>Product · data · ML · <span class="co">APG · PadSquad · HPE</span></h3>
              <ul>
                <li>ESG + NLP/ML on Azure Databricks; growth product in AdTech; CNN assistive-tech at 97.9%.</li>
                <li>Columbia MSBA · VIT CSE · four ML research publications.</li>
              </ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="wrap">
        <p class="kicker">Contact</p>
        <h2 class="section-title">If you’re building with AI.</h2>
        <div class="contact-row">
          <a href="mailto:garvit.khurana@columbia.edu">garvit.khurana@columbia.edu</a>
          <a href="https://www.linkedin.com/in/garvitkhurana/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://github.com/garvitkhurana" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="wrap">
    <span>© <span id="y"></span> Garvit Khurana</span>
    <span>AI engineer · AI product</span>
  </footer>
</BaseLayout>
